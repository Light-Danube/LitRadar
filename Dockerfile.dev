# Isolated test runner: no runtime secrets, no host mounts, no network by default.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HOME=/tmp
WORKDIR /app
# Match the offline web CI dependencies; semantic models are optional and the
# tests use synthetic embeddings rather than downloading a model at runtime.
COPY requirements-web.txt requirements-dev.txt ./
RUN python -m pip install --no-cache-dir -r requirements-web.txt -r requirements-dev.txt
# Cloud checkouts may have owner-only permissions. Give the test UID access
# without making private source files world-readable or running tests as root.
COPY --chown=10001:10001 . /app
RUN mkdir -p /app/data /app/reports /app/logs \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin litbeacon \
    && chown -R 10001:10001 /app/data /app/reports /app/logs
USER 10001:10001
CMD ["python", "-m", "pytest", "-q", "-rs", "-o", "cache_dir=/tmp/pytest-cache"]
