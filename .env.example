# LitRadar source configuration
# Enable/disable registered providers without changing Python code.
LITRADAR_SOURCES=openalex,semantic_scholar,arxiv
LITRADAR_SOURCE_WORKERS=3
LITRADAR_SOURCE_TIMEOUT=20
LITRADAR_SOURCE_RETRIES=3
LITRADAR_SOURCE_BACKOFF=2
LITRADAR_SOURCE_CACHE_TTL=3600

# OpenAlex: API keys are required for normal production-scale use since 2026.
OPENALEX_API_KEY=

# Semantic Scholar: optional, but recommended for stable authenticated rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Optional legal open-access PDF fallback via Unpaywall (requires your email)
UNPAYWALL_EMAIL=

# Legacy mailto setting retained only for compatibility; OpenAlex no longer uses
# the pre-2026 "polite pool" mechanism.
LITRADAR_MAILTO=you@example.com

# v0.5 personalized ranking
LITRADAR_PERSONALIZATION_ENABLED=true
LITRADAR_PERSONALIZATION_WEIGHT=0.20
LITRADAR_PERSONALIZATION_MIN_FEEDBACK=5
LITRADAR_PERSONALIZATION_SCAN_LIMIT=5000

# Optional LLM settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITRADAR_LLM_PROVIDER=none
LITRADAR_LLM_MODEL=
