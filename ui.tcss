Screen {
    layout: vertical;
}

#toolbar {
    height: 3;
    padding: 0 1;
}

#search {
    width: 1fr;
}

#status {
    width: 20;
    margin-left: 1;
}

#sort {
    width: 20;
    margin-left: 1;
}

#tag {
    width: 22;
    margin-left: 1;
}

#library_count {
    width: 26;
    margin-left: 1;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#papers {
    width: 2fr;
}

#details {
    width: 1fr;
    border: solid $primary;
    padding: 1 2;
    overflow-y: auto;
}

#details_title {
    text-style: bold;
    margin-bottom: 1;
}

#details_body {
    overflow-y: auto;
}

HelpScreen,
TagScreen,
ScheduleScreen {
    align: center middle;
    background: $background 80%;
}

#help_dialog,
#tag_dialog {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: solid $primary;
    background: $panel;
}

#help_dialog {
    height: 90%;
}

#help_scroll {
    height: 1fr;
}

#help_body {
    height: auto;
}

#help_close {
    margin-top: 1;
}

#language {
    width: 20;
}

Button:focus, Input:focus, Select:focus, #papers:focus,
#details:focus, #help_scroll:focus, #schedule_dialog:focus, #schedule_status_scroll:focus {
    border: heavy $accent;
}

#tag_title {
    text-style: bold;
    margin-bottom: 1;
}

#tag_error {
    height: auto;
    color: $error;
}

#tag_existing {
    color: $text-muted;
    margin-bottom: 1;
}

#tag_input {
    width: 1fr;
}

#tag_buttons {
    height: 3;
    margin-top: 1;
}

#tag_cancel {
    margin-left: 1;
}

#actionbar {
    height: 3;
    padding: 0 1;
}

#search_sources {
    width: 28;
    margin-right: 1;
}

#source_query {
    width: 1fr;
}

.compact #toolbar {
    layout: grid;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 3 3;
    height: 6;
}

.compact #search {
    column-span: 3;
}

.compact #status, .compact #sort, .compact #tag,
.compact #library_count {
    width: 1fr;
    margin-left: 0;
}

.compact #library_count {
    column-span: 2;
}

.compact #search_sources {
    width: 24;
}

.compact #language {
    width: 16;
}

#search_progress_row {
    height: 5;
    padding: 0 1;
}

#search_progress {
    width: 28;
    margin-right: 1;
    content-align: left middle;
}

#search_status {
    width: 1fr;
    height: 5;
    content-align: left top;
    color: $text-muted;
    padding: 0 1;
    border: round $primary;
    overflow-y: auto;
}

#schedule_dialog {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#schedule_title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#schedule_help {
    height: auto;
    margin-bottom: 1;
}

#schedule_status_scroll {
    height: 8;
    border: round $panel;
    padding: 1;
    overflow-y: auto;
    margin-bottom: 1;
}

#schedule_status {
    height: auto;
}

#schedule_action_row, #schedule_remove_row {
    layout: vertical;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#schedule_action_row Button, #schedule_remove_row Button {
    width: 100%;
    height: 3;
}
