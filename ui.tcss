Screen {
    layout: vertical;
}

#toolbar {
    height: 3;
    padding: 0 1;
}

#search {
    width: 1fr;
}

#status {
    width: 20;
    margin-left: 1;
}

#sort {
    width: 20;
    margin-left: 1;
}

#tag {
    width: 22;
    margin-left: 1;
}

#library_count {
    width: 26;
    margin-left: 1;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#papers {
    width: 2fr;
}

#details {
    width: 1fr;
    border: solid $primary;
    padding: 1 2;
    overflow-y: auto;
}

#details_title {
    text-style: bold;
    margin-bottom: 1;
}

#details_body {
    overflow-y: auto;
}

HelpScreen,
TagScreen {
    align: center middle;
    background: $background 80%;
}

#help_body,
#tag_dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: solid $primary;
    background: $panel;
}

#tag_title {
    text-style: bold;
    margin-bottom: 1;
}

#tag_existing {
    color: $text-muted;
    margin-bottom: 1;
}

#tag_input {
    width: 1fr;
}

#tag_buttons {
    height: 3;
    margin-top: 1;
}

#tag_cancel {
    margin-left: 1;
}

#actionbar {
    height: 3;
    padding: 0 1;
}

#search_sources {
    width: 28;
    margin-right: 1;
}

#search_progress_row {
    height: 5;
    padding: 0 1;
}

#search_progress {
    width: 28;
    margin-right: 1;
    content-align: left middle;
}

#search_status {
    width: 1fr;
    height: 5;
    content-align: left top;
    color: $text-muted;
    padding: 0 1;
    border: round $primary;
    overflow-y: auto;
}

#schedule_dialog {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#schedule_title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#schedule_help {
    height: auto;
    margin-bottom: 1;
}

#schedule_status {
    height: 8;
    border: round $panel;
    padding: 1;
    overflow-y: auto;
    margin-bottom: 1;
}

#schedule_action_row, #schedule_remove_row {
    height: auto;
    align: center middle;
    margin-top: 1;
}
